<?xml version="1.0" encoding="utf-8"?>
<Mod id="9cf97418-39b2-45ed-8f4b-2f75c9dc8e8a" version="1">
  <Properties>
    <Name>Urdnot's Revolutionary France - Robespierre</Name>
    <Stability>Alpha</Stability>
    <Teaser>Adds the Republic of Virtue, [COLOR_POSITIVE_TEXT]Revolutionary France[ENDCOLOR] to the game as a playable civilisation.</Teaser>
    <Description>Adds the Republic of Virtue, [COLOR_POSITIVE_TEXT]Revolutionary France[ENDCOLOR] to the game as a playable civilisation. Birth your nation anew with France's unique ability to gain yields not through slowly building your cities up, but by radically tansforming them! Sell buildings for massive gains of culture and happiness, and sacrifice your citizens at the glorious altar of madame la guillotine for even greater yields! All the while, make sure your national guards are watching on, gaining massive xp bonuses as you tear down the stifling edifice of the past!</Description>
    <Authors>Urdnot</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>1</ReloadAudioSystem>
    <ReloadLandmarkSystem>1</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>1</ReloadStrategicViewSystem>
    <ReloadUnitSystem>1</ReloadUnitSystem>
  </Properties>
